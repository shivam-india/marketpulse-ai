# ==============================================================================
# MarketPulse AI — Environment Variable Configuration Template
# ==============================================================================
#
# Copy this file to `.env.local` and add your real keys:
#   cp .env.example .env.local
#
# NOTE: All keys are optional. The platform includes resilient failover architectures
# and transparent disclaimers when external providers are offline.
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. AI Reasoning & Computer Vision (Screenshot Analysis)
# ------------------------------------------------------------------------------
# Google Gemini API (Get free key: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Optional: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 2. Market Data & Real-Time Price Feeds
# ------------------------------------------------------------------------------
# Finnhub API (Get free key: https://finnhub.io/)
# Powers real-time quotes for Forex, Indices, and Commodities
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API (Get free key: https://www.alphavantage.co/)
# Secondary provider for historical daily/intraday candle bars
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io API (Get free key: https://polygon.io/)
# High-precision Forex & Gold/Silver spot aggregates and 15m/1h/1d candles
POLYGON_API_KEY=your_polygon_api_key_here

# ------------------------------------------------------------------------------
# 3. Financial News Intelligence & Macro Headlines
# ------------------------------------------------------------------------------
# NewsAPI (Get free key: https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# MarketAux API (Optional: https://www.marketaux.com/)
MARKETAUX_API_KEY=your_marketaux_api_token_here


# ------------------------------------------------------------------------------
# 4. Global Economic Calendar
# ------------------------------------------------------------------------------
# Automatically connects to Forex Factory high-impact public weekly JSON feed.
# Optional secondary custom feed:
ECONOMIC_CALENDAR_API_KEY=

# ------------------------------------------------------------------------------
# 5. Order Flow & L2 Depth of Market (DOM)
# ------------------------------------------------------------------------------
# Automatically connects to Binance Public Spot L2 Order Book & Aggregated Trades.
# Authenticated key is optional for higher rate limits:
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ------------------------------------------------------------------------------
# 6. Database / Relational Persistence (Optional)
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase connection URL (Defaults to high-speed in-memory store)
DATABASE_URL=
